# Copy to .env.local for local dev. On Vercel, set these in
# Project Settings -> Environment Variables instead.

# Stripe secret key. Starts sk_test_ while you're testing, sk_live_ when real.
# Until this is set, buy buttons fall back to the waitlist modal.
STRIPE_SECRET_KEY=sk_test_...

# Optional. The public URL Stripe returns customers to after payment.
# Leave unset and the site works it out from the incoming request.
# NEXT_PUBLIC_SITE_URL=https://sales-app-pi-eight.vercel.app
