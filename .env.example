# Copy to .env. Every key is OPTIONAL — the app runs fully on mock adapters without any of them.

# Server port
PORT=3000

# Real LLM adapter (script/storyboard generation). Leave unset to use the mock LLM.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Real trend sources (stubs — mock trend adapter is used when unset)
YOUTUBE_API_KEY=
META_AD_LIBRARY_TOKEN=

# Real video model adapters (stubs — mock render pipeline is used when unset)
HIGGSFIELD_API_KEY=
